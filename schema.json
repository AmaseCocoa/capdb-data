{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoodleProduct",
  "type": "object",
  "required": [
    "jan",
    "name",
    "has_drain",
    "wait_seconds",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "jan": {
      "type": "string",
      "description": "EAN-13形式のJANコード（13桁の半角数字、チェックディジットを含む）",
      "pattern": "^[0-9]{13}$"
    },
    "name": {
      "type": "string",
      "description": "商品の正式名称",
      "minLength": 1
    },
    "has_drain": {
      "type": "boolean",
      "description": "湯切りが必要な商品（焼きそば等）なら true"
    },
    "links": {
      "type": "object",
      "description": "公式情報へのリンク",
      "required": [
        "official"
      ],
      "additionalProperties": false,
      "properties": {
        "official": {
          "type": "string",
          "format": "uri",
          "description": "メーカー公式の商品カタログ・ブランドページのURL"
        }
      }
    },
    "wait_seconds": {
      "type": "integer",
      "description": "熱湯を注いでから湯切り・食べるまでの時間（秒）",
      "minimum": 0,
      "maximum": 900
    }
  }
}
